# Copier en .env :  cp .env.example .env
# Aucune valeur ci-dessous n'est un vrai secret : à changer si la machine est partagée.

# --- Docker / Airflow -------------------------------------------------------
# Sous Linux, mettre le résultat de `id -u` (propriétaire des fichiers de logs/ et data/).
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Secret de signature des jetons entre composants Airflow (n'importe quelle chaîne longue).
AIRFLOW_JWT_SECRET=change-me-local-only
# Clé Fernet pour chiffrer les connexions Airflow (vide = pas de chiffrement, acceptable en local).
FERNET_KEY=

# --- PostgreSQL (bases `airflow` et `gazette`) ------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# --- Paquet gazette ---------------------------------------------------------
# E-mail de contact inclus dans le User-Agent envoyé aux éditeurs (obligatoire pour collecter).
GAZETTE_CONTACT_EMAIL=contact@example.org
GAZETTE_TIMEZONE=Europe/Paris
# Chemins relatifs au dossier courant hors Docker (écrasés par docker-compose dans les conteneurs).
GAZETTE_DATA_DIR=data
GAZETTE_SOURCES_FILE=sources.csv
# Base gazette vue depuis la machine hôte (port 5433 exposé par docker-compose).
GAZETTE_DATABASE_URL=postgresql://airflow:airflow@localhost:5433/gazette
# Politesse HTTP
GAZETTE_HTTP_TIMEOUT=20
GAZETTE_DOMAIN_DELAY=2
GAZETTE_MAX_ATTEMPTS=3
